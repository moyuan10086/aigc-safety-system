MLLM_API_KEY=your_api_key_here
MLLM_BASE_URL=https://api.openai.com/v1
MLLM_MODEL=gpt-5.6-sol
CHAT_MODEL_NAME=gpt-5.6-sol
DEEPFAKE_MODEL_PATH=../deepfake-detection/weights/model.ckpt
DEEPFAKE_MODEL_REPO=yermandy/deepfake-detection
DEEPFAKE_MODEL_REVISION=9a6857ec642deb57373c5437be803a199468b8c6
DEEPFAKE_MODEL_FILENAME=model.ckpt
DEEPFAKE_MODEL_SHA256=57a0d00f2f5b4046afd2c344ff9877a35e8889e075916cf816796c54816c9955
DEEPFAKE_BACKBONE_REVISION=32bd64288804d66eefd0ccbe215aa642df71cc41
DEEPFAKE_FACE_MODEL_PATH=../deepfake-detection/weights/face_detection_yunet_2023mar.onnx
DEEPFAKE_FACE_MODEL_URL=https://media.githubusercontent.com/media/opencv/opencv_zoo/47534e27c9851bb1128ccc0102f1145e27f23f98/models/face_detection_yunet/face_detection_yunet_2023mar.onnx
DEEPFAKE_FACE_MODEL_SHA256=8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4
DEEPFAKE_REAL_THRESHOLD=0.20
DEEPFAKE_FAKE_THRESHOLD=0.80
DEEPFAKE_FACE_MARGIN=0.15
DEEPFAKE_MAX_FACES=8
DEEPFAKE_CACHE_SIZE=128
CHROMA_PATH=./rag_db
LEXICON_PATH=../数字人前端/backend/Sensitive-lexicon/Vocabulary
AUTH_USERNAME=operator
AUTH_DISPLAY_NAME=安全审核员
AUTH_ROLE=operator
# Generate with: uv run python -c "from services.auth_service import hash_password; print(hash_password('replace-me'))"
AUTH_PASSWORD_HASH=
# Optional single-line JSON array for distinct reviewer identities. Duplicate
# usernames or invalid entries fail closed. Existing AUTH_* remains valid.
AUTH_OPERATORS_JSON=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
# Optional: defaults to AUTH_SESSION_SECRET. Tokens are exact-action,
# short-lived and single-use; use a dedicated secret in production.
AGENT_APPROVAL_SIGNING_SECRET=
AGENT_APPROVAL_TTL_SECONDS=300
AGENT_APPROVAL_MAX_TTL_SECONDS=900
# Optional: defaults to AUTH_SESSION_SECRET when omitted. Use a dedicated
# high-entropy value in production. Rotation supports a previous-secret grace window.
API_KEY_HASH_SECRET=
API_KEY_HASH_PREVIOUS_SECRET=
API_KEY_DB_PATH=audit_logs/api_keys.db
API_KEY_DEFAULT_RATE_LIMIT=60
API_KEY_DEFAULT_DAILY_QUOTA=5000
API_KEY_MAX_RATE_LIMIT=600
API_KEY_MAX_DAILY_QUOTA=100000
API_SCAN_MAX_CONCURRENCY=1
API_SCAN_MAX_ACTIVE_PER_KEY=1
AUDIT_CONTENT_KEY=
AUDIT_CONTENT_PREVIOUS_KEY=
AUDIT_ARCHIVE_PATH=audit_archives
# Repository-owned XGBoost shadow evaluator. It never changes the online verdict.
# Keep the pinned digest aligned with vendor/aigc-local-auditor/MODEL_SHA256.
GUARDRAIL_ENABLE_XGBOOST_SHADOW=true
GUARDRAIL_XGBOOST_SHADOW_MODULE_PATH=../vendor/aigc-local-auditor
GUARDRAIL_XGBOOST_SHADOW_MODEL_PATH=../vendor/aigc-local-auditor/security_audit_system/models/hybrid_safety_model_xgboost_color.json
GUARDRAIL_XGBOOST_SHADOW_SHA256=570bd09b358186af1f902ff3bc2b9a463da09a8921d22b72f04978248e5c8180
# Run independent RAG/model experts concurrently without changing verdict fusion.
GUARDRAIL_PARALLEL_EXPERTS=true
GUARDRAIL_EXPERT_MAX_WORKERS=4
