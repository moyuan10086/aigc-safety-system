MLLM_API_KEY=your_api_key_here
MLLM_BASE_URL=https://api.openai.com/v1
MLLM_MODEL=gpt-4o
# Local NudeNet adult-content specialist. Keep shadow mode enabled until a
# representative labeled benchmark has been calibrated and reviewed.
NUDENET_ENABLED=false
NUDENET_MODEL_PATH=
NUDENET_SHADOW_ONLY=true
NUDENET_THRESHOLD=0.6
UNSAFE_BENCH_ENABLED=false
UNSAFE_BENCH_PRIMARY=false
UNSAFE_BENCH_ENDPOINT=
UNSAFE_BENCH_MODEL=multiheaded
UNSAFE_BENCH_TIMEOUT_SECONDS=30

# Heavy LLaVA-based secondary reviewer. Keep the API key in a mode-0600 file
# in production instead of placing the secret directly in .env.
PERSPECTIVE_VISION_ENABLED=false
PERSPECTIVE_VISION_ENDPOINT=
PERSPECTIVE_VISION_API_KEY=
PERSPECTIVE_VISION_API_KEY_FILE=
PERSPECTIVE_VISION_MODEL=PerspectiveVision-LLaVA-LoRA
PERSPECTIVE_VISION_TIMEOUT_SECONDS=20
DEEPFAKE_MODEL_PATH=../deepfake-detection/weights/model.torchscript
CHROMA_PATH=./rag_db
LEXICON_PATH=../数字人前端/backend/Sensitive-lexicon/Vocabulary
AUTH_USERNAME=operator
AUTH_DISPLAY_NAME=安全审核员
AUTH_ROLE=operator
# Generate with: uv run python -c "from services.auth_service import hash_password; print(hash_password('replace-me'))"
AUTH_PASSWORD_HASH=
# Optional single-line JSON array for distinct reviewer identities. Duplicate
# usernames or invalid entries fail closed. Existing AUTH_* remains valid.
AUTH_OPERATORS_JSON=
AUTH_SESSION_SECRET=
INVISIBLE_WATERMARK_SIGNING_SECRET=
AUTH_SESSION_TTL_SECONDS=28800
AUTH_COOKIE_SECURE=false
# Optional: defaults to AUTH_SESSION_SECRET. Tokens are exact-action,
# short-lived and single-use; use a dedicated secret in production.
AGENT_APPROVAL_SIGNING_SECRET=
AGENT_APPROVAL_TTL_SECONDS=300
AGENT_APPROVAL_MAX_TTL_SECONDS=900
# Optional: defaults to AUTH_SESSION_SECRET when omitted. Use a dedicated
# high-entropy value in production. Rotation supports a previous-secret grace window.
API_KEY_HASH_SECRET=
API_KEY_HASH_PREVIOUS_SECRET=
API_KEY_DB_PATH=audit_logs/api_keys.db
API_KEY_DEFAULT_RATE_LIMIT=60
API_KEY_DEFAULT_DAILY_QUOTA=5000
API_KEY_MAX_RATE_LIMIT=600
API_KEY_MAX_DAILY_QUOTA=100000
API_SCAN_MAX_CONCURRENCY=1
API_SCAN_MAX_ACTIVE_PER_KEY=1
AUDIT_CONTENT_KEY=
AUDIT_CONTENT_PREVIOUS_KEY=
AUDIT_ARCHIVE_PATH=audit_archives
# Optional local XGBoost shadow evaluator. It never changes the online verdict.
# The model digest is mandatory when this switch is enabled.
GUARDRAIL_ENABLE_XGBOOST_SHADOW=false
GUARDRAIL_XGBOOST_SHADOW_MODULE_PATH=
GUARDRAIL_XGBOOST_SHADOW_MODEL_PATH=
GUARDRAIL_XGBOOST_SHADOW_SHA256=
# Run independent RAG/model experts concurrently without changing verdict fusion.
GUARDRAIL_PARALLEL_EXPERTS=true
GUARDRAIL_EXPERT_MAX_WORKERS=4
